LAMMPS (22 Jul 2025 - Update 3)
# LAMMPS input file for Silicon Carbide with Tersoff potential
# Description: Creates cubic box of SiC, minimizes, then runs NVE and NVT with temperature ramp

# Initialize simulation
units 		metal
dimension	3
boundary	p p p
atom_style	atomic

#neighbor        3.0 bin
#neigh_modify every 1 delay 0 check no

# Create simulation box and lattice: 3C-SiC as two shifted fcc
variable        N equal 20
lattice 	fcc 4.36 origin 0 0 0
Lattice spacing in x,y,z = 4.36 4.36 4.36
region		box block 0 ${N} 0 ${N} 0 ${N}
region		box block 0 20 0 ${N} 0 ${N}
region		box block 0 20 0 20 0 ${N}
region		box block 0 20 0 20 0 20
create_box	2 box
Created orthogonal box = (0 0 0) to (87.2 87.2 87.2)
  1 by 1 by 2 MPI processor grid
create_atoms 	1 box
Created 32000 atoms
  using lattice units in orthogonal box = (0 0 0) to (87.2 87.2 87.2)
  create_atoms CPU = 0.000 seconds
lattice 	fcc 4.36 origin 0.25 0.25 0.25
Lattice spacing in x,y,z = 4.36 4.36 4.36
create_atoms	2 box
Created 32000 atoms
  using lattice units in orthogonal box = (0 0 0) to (87.2 87.2 87.2)
  create_atoms CPU = 0.001 seconds


# Define masses
mass            1 28.0855  # Silicon
mass            2 12.0107  # Carbon

# Define Tersoff potential
pair_style      tersoff
pair_coeff      * * SiC_1989.tersoff Si C
Reading tersoff potential file SiC_1989.tersoff with DATE: 2011-05-03

# Output settings
thermo          10
thermo_style    custom step temp pe ke etotal press lx ly lz vol
compute         peat all pe/atom

region          reg_Si block 0 0.1 0 0.1 0 0.1 units lattice
group		Si_atom region reg_Si
1 atoms in group Si_atom
region          reg_C block 0.2 0.3 0.2 0.3 0.2 0.3 units lattice
group		C_atom region reg_C
1 atoms in group C_atom
compute 	Si Si_atom reduce ave x y z vx vy vz c_peat
compute 	C C_atom reduce ave x y z vx vy vz c_peat


# Energy minimization
fix             1 all box/relax x 0.0 y 0.0 z 0.0 couple none
minimize        1e-10 1.0e-12 50000 100000

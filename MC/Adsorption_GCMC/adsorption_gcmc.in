# =============================================================================
# Gas Adsorption on a Solid Surface via GCMC
# =============================================================================
#
# Use two model materials, a slab of frozen fcc with LJ type 1, with
# again LJ, type 2 gas atoms, inserted/deleted by GCMC in the vacuum above the slab
#
# Key parameter: pair_coeff 1 2 epsilon_12 which controls whether 2 wants to adsorb onto 1
# epsilon_12 = 1.5  -> strong attraction  -> clear adsorption layer forms
# epsilon_12 = 0.5  -> weak attraction    -> gas distributes uniformly

# key variables
variable  mu    equal  -2.0	# chemical potential
variable  T  equal   0.5	# temperature
variable  eps12 equal 2.0	# interaction between 1 and 2

# --- initialisation --------------------------------------------

units         	lj
atom_style    	atomic
boundary     	p p p

lattice		fcc 1.0 	# unitary with JL units 
variable  	L   equal  6	# box
variable  	H    equal  18  # box
variable  	h_slab  equal  3	# solid slab

region    	simbox  block  0 ${L}  0 ${L}  0 ${H} units lattice
create_box  	2 simbox

mass  		1  1.0
mass  		2  1.0


# create the atoms
region  slab_region  block  0 ${L}  0 ${L}  0 ${h_slab} units lattice
create_atoms  1 region slab_region

region  vacuum  block  0 ${L}  0 ${L}  $(v_h_slab+.01) $(v_H-.01)  units lattice
#write_data initial

# --- potential  ----------------------------------------------------

pair_style  lj/cut  2.5
pair_coeff  1 1  1.0  1.0   # solid-solid: standard LJ
pair_coeff  2 2  0.5  1.0   # gas-gas: weak self-interaction
pair_coeff  1 2  ${eps12}  1.0   # solid-gas: key parameter

pair_modify  tail  no

neighbor      0.3  bin
neigh_modify  delay 0  every 1

# --- groups ------------------------------------------------------

group  solid  type 1
group  gas    type 2          # empty at start, filled by GCMC

minimize  1.0e-6  1.0e-8  1000  10000
reset_timestep 0

# freeze the slab: zero all forces on slab atoms and set their velocities to zero.
# They define the surface potential landscape but do not move. 
# This allows us to change temperature without worrying for the slab to melt.
velocity  solid  set  0.0 0.0 0.0
fix  freeze_slab  solid  setforce  0.0 0.0 0.0

# --- fix GCMC  -----------------------------------------------------
# Restrict insertions to the vacuum above the slab.

fix  mygcmc  gas  gcmc  1  500  500  2  54321  ${T}  ${mu}  0.5  region  vacuum

# N_gas fluctuates, so degrees of freedom must be recomputed dynamically.
compute_modify  thermo_temp  dynamic/dof  yes


# --- output ------------------------------------------------
# fix gcmc returns an array whose components are: translation: attempts and successes
# insertion: attempts and successes, deletion: attempts and successes

# define accordingly variables for output: number of gas atoms, acceptance rates for insertion, deletion and translations
variable  n_gas  equal  count(gas)
variable  iacc   equal  f_mygcmc[4]/(f_mygcmc[3]+1e-6)
variable  dacc   equal  f_mygcmc[6]/(f_mygcmc[5]+1e-6)
variable  tacc   equal  f_mygcmc[2]/(f_mygcmc[1]+1e-6)

thermo_style  custom  step  atoms  v_n_gas  temp  press  v_iacc  v_dacc  v_tacc
thermo  10


# ---  run  -------------------------------------------------------
variable 	Neq equal 2500
variable 	Nrun equal 5000

# first run a Neq steps of initialisation
# export dump files and dat files
dump  eq  all  atom  10  adsorption_mu_${mu}_T_${T}_eps12_${eps12}.dump
fix  print_thermo  all  print  1  "$(atoms) $(v_n_gas) $(v_iacc) $(v_dacc) $(v_tacc)" file adsorption_mu_${mu}_T_${T}_eps12_${eps12}_equil.dat screen  no title "# atoms n_gas iacc dacc tacc"
run  ${Neq}
undump eq

# and now the main run where we collect the data

# Compute a density of gas atoms as a function of z with the following 2 commands:
# see docs for compute chunk/atom command. We define bins in z to count atoms inside a slab. We consider only atoms in group "gas".
compute  zchunk  gas  chunk/atom  bin/1d  z  lower  0.1 units lattice nchunk once
# while this averages the atom count in each bin over time. We average at timestep Neq+Nrun (the final one) using a profile every 10 steps for the Nrun steps. So Nrun/10 profiles. See fix ave/chunk command
fix  zprofile  gas  ave/chunk  10 $(v_Nrun/10) $(v_Neq+v_Nrun)  zchunk  density/number ave running file density_profile_mu_${mu}_T_${T}_eps12_${eps12}.dat

# dump atomic structure for visualisation and print to file the number of gas atoms and the rates from fix gcmc
dump  run  all  atom  100  adsorption_mu_${mu}_T_${T}_eps12_${eps12}.dump
dump_modify run append yes
fix  print_thermo  all  print  1  "$(atoms) $(v_n_gas) $(v_iacc) $(v_dacc) $(v_tacc)"  file adsorption_mu_${mu}_T_${T}_eps12_${eps12}_run.dat  screen  no title "# atoms n_gas iacc dacc tacc"

# run
run  ${Nrun}


# Solid state intermixing of two blocks of Ag and Au
# Use as example of Monte Carlo fix atom/swap
# We create two pieces of pure Ag and pure Au and use the fact
# that they mix very well. Add 1% vacancies to speed up the mixing 
# and try with thermal agitation alone. Optionally add the atom/swap fix.
# Use a high temperature of 900C, close to melting.

units           metal
dimension       3
boundary        p p p
atom_style      atomic

# ---------- Lattice ----------
variable        a equal 4.09     # fcc lattice constant
lattice         fcc ${a}
variable	N equal 6

# ---------- Simulation box ----------
region          whole block 0 $N 0 $N 0 $N units lattice
create_box      2 whole 	# foresee two atom types

# ---------- Regions ----------
region          left  block 0 $(v_N/2.0) 0 $N 0 $N units lattice
region          right block $(v_N/2.0) $N 0 $N 0 $N units lattice

create_atoms    1 region left
create_atoms    2 region right

# this is required to fix a overlapping layer of Ag and Au atoms occupying the same sites
region          overlap_reg block $(v_N/2.01) $(v_N/1.99) 0 $N 0 $N units lattice
group		overlap region overlap_reg
group		Ag type 1
group		Ag_overlap intersect overlap Ag
delete_atoms	group Ag_overlap

# ---------- Masses ----------
mass            1 107.8682   # Ag
mass            2 196.9665   # Au

# ---------- MEAM potential and neighbour list ----------
pair_style      meam
pair_coeff      * * AgAu.library.meam Ag Au AgAu.parameter.meam Ag Au
neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes

# --------  Output  ------------
compute         peat all pe/atom      # compute per-atom energy
compute         strat all stress/atom NULL # compute per-atom stress
thermo          10
thermo_style    custom step temp pe ke etotal press


# --------  Simulation  -----------

# start by minimising to the two different equilibrium lattice spacings

minimize        1e-8 1.0e-12 50000 100000
# allow the crystals to shrink/expand from the initial shared lattice spacing
fix     	1 all box/relax x 0.0 y 0.0 z 0.0 couple none
minimize        1e-10 1.0e-12 50000 100000
unfix 		1
write_dump      all custom initial_AgAu.dump id type x y z c_peat c_strat[1] c_strat[2] c_strat[3] c_strat[4] c_strat[5] c_strat[6]

# create the 1% vacancy concentration and minimise again to relax atoms near the vacancies
delete_atoms	random fraction 0.01 yes all NULL 482793

minimize        1e-8 1.0e-12 50000 100000
fix     	1 all box/relax x 0.0 y 0.0 z 0.0 couple none
minimize        1e-10 1.0e-12 50000 100000
unfix 		1

# optional for visualisation
write_dump      all custom initial_AgAu_1pcv.dump id type x y z c_peat c_strat[1] c_strat[2] c_strat[3] c_strat[4] c_strat[5] c_strat[6]
write_data	initial_AgAu_1pcv


# ---------- Main run: hold at NVT ----------

timestep        0.001   # 1 fs default

# Give initial velocities and see kineting energy transferred to potential
velocity        all create 600.0 4928459 mom yes rot no dist gaussian
fix             1 all nve
run             1000
unfix 1
# temperature ramp to 900 C
fix             2 all nvt temp 300.0 1073.0 $(100*dt)
run		1000
unfix		2
# NPT run to hold at temperature while relaxing the pressure to near zero
fix             3 all npt temp 1173.0 1173.0 $(100*dt) iso 40000.0 0.0 $(1000*dt) # (I saw that we get to about 40 kbar at this point)
run		4000
unfix		3

# Here is the main NVT run
reset_timestep	0
dump      	mydump all custom 1 AgAu_1pcv_900C.dump id type x y z c_peat c_strat[1] c_strat[2] c_strat[3] c_strat[4] c_strat[5] c_strat[6]
fix             4 all nvt temp 1173.0 1173.0 $(100*dt)

# Optionally comment/uncomment to add the MC mixing as well
fix 		5 all atom/swap 10 1 29494 1073.0 semi-grand no ke yes types 1 2   # every 10 steps attempt one swap

run             3000   # with a few thousands, no mixing will happen with temperature alone
write_data	final_AgAu
write_restart	rest
